{
  "manifest_version": 3,
  "name": "Daily Work Log - Teams Task Tracker",
  "version": "2.0.0",
  "description": "Log daily work items, track task progress, and export formatted updates for Microsoft Teams.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.microsoft.com/*",
    "*://*.office.com/*",
    "*://*.cloud.microsoft/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.microsoft.com/*",
        "*://*.office.com/*",
        "*://*.cloud.microsoft/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
